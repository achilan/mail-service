{
  "name": "mail-service",
  "version": "2.0.0",
  "description": "API para enviar correos electrónicos por SMTP con plantillas HTML editables por API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "audit": "npm audit --omit=dev",
    "start": "node dist/server.js",
    "build": "esbuild src/server.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true,filter:(s)=>!s.endsWith('.js')})\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.3",
    "express-rate-limit": "8.7.2",
    "handlebars": "4.7.10",
    "helmet": "8.3.0",
    "nodemailer": "10.3.1",
    "sanitize-html": "2.18.1",
    "swagger-ui-dist": "5.33.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}

# Copia este archivo a .env y ajusta valores. NUNCA subas .env al repositorio.
NODE_ENV=production
PORT=3000

# ───────────── Autenticación ─────────────
# Llave legada (todos los permisos). Genera una con:  openssl rand -hex 32
API_KEY=pon-una-llave-aleatoria-de-64-caracteres

# Llaves con permisos mínimos (recomendado): id:secreto:scope1|scope2, separadas por coma.
# Scopes: mail:send · mail:send:raw · templates:read · templates:write · admin · *
# API_KEYS=backend:SECRETO1:mail:send,disenador:SECRETO2:templates:write,ops:SECRETO3:admin

# ───────────── SMTP (ejemplo Hostinger) ─────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true            # true = puerto 465 (SSL) | false = puerto 587 (STARTTLS obligatorio)
SMTP_USER=tucorreo@tudominio.com
SMTP_PASS=la_contraseña_del_buzón
# MAIL_TRANSPORT=json       # dry-run: genera el correo pero no lo envía (pruebas)

# Remitente
MAIL_FROM_NAME=Tu Servicio
MAIL_FROM_EMAIL=tucorreo@tudominio.com
# MAIL_REPLY_TO=soporte@tudominio.com

# DKIM opcional (mejora entregabilidad). La clave puede ir con \n escapados.
# DKIM_DOMAIN=tudominio.com
# DKIM_SELECTOR=mail
# DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ───────────── Marca (aplica a todas las plantillas; también editable por API) ─────────────
BRAND_NAME=Tu Servicio
# BRAND_LOGO_URL=https://tudominio.com/logo.png
BRAND_PRIMARY_COLOR=#4F46E5
BRAND_ACCENT_COLOR=#06B6D4
# BRAND_WEBSITE=https://tudominio.com
# BRAND_SUPPORT_EMAIL=soporte@tudominio.com
# BRAND_ADDRESS=Av. Principal 123, Guayaquil, Ecuador
# BRAND_FOOTER_NOTE=Recibes este correo porque tienes una cuenta con nosotros.

# Íconos: cid = PNG incrustado en el correo (recomendado) | url = servidos desde PUBLIC_URL
# ICON_MODE=cid
# PUBLIC_URL=https://mail.tudominio.com

# ───────────── Red y seguridad ─────────────
# Orígenes permitidos para llamadas desde navegador. Sin definir = cualquiera (compatibilidad).
# CORS_ORIGINS=https://app.tudominio.com,https://admin.tudominio.com
# TRUST_PROXY=1             # número de proxies delante (Nginx, Cloudflare…)
# RATE_LIMIT_MAX=1200       # peticiones por minuto por llave
# RATE_LIMIT_SEND_MAX=600   # envíos por minuto por llave
# RATE_LIMIT_AUTH_FAIL_MAX=20  # intentos fallidos de API key por IP cada 15 min
# MAIL_MAX_RECIPIENTS=50
# ALLOWED_RECIPIENT_DOMAINS=tudominio.com   # restringe a quién se puede enviar

# Adjuntos por URL (protección SSRF: IPs privadas bloqueadas)
# ATTACHMENT_URL_ALLOWLIST=storage.tudominio.com
# ATTACHMENT_TRUSTED_HOSTS=api.interna.local   # hosts internos permitidos explícitamente
# ATTACHMENT_ALLOW_HTTP=true
# ATTACHMENT_MAX_BYTES=15728640

# ───────────── Funcionalidades ─────────────
# ENABLE_DOCS=true          # /docs (Swagger UI) y /openapi.json
# ENABLE_PREVIEW=true       # /preview (galería con datos de ejemplo)
# DATA_DIR=./data           # plantillas editadas, branding y auditoría

# ───────────── Cola ─────────────
# QUEUE_CONCURRENCY=5
# QUEUE_MAX_ATTEMPTS=3
# QUEUE_RETRY_BASE_MS=2000
# QUEUE_JOB_TTL_MS=1800000
# JSON_LIMIT=25mb

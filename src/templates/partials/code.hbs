{{!-- Código grande (OTP / acceso). Uso: {{> code value=code label="Tu código"}} --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:4px 0 28px;border-collapse:separate;">
  <tr>
    <td align="center" class="em-panel" bgcolor="#F9FAFB" style="padding:26px 16px 28px;background-color:#F9FAFB;border:1.5px dashed {{toneColor 'brand' 'border'}};border-radius:16px;">
      <p class="em-muted" style="margin:0 0 10px;font-size:12px;line-height:18px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#667085;">{{fallback label 'Tu código'}}</p>
      <p class="em-heading" style="margin:0;padding-left:0.3em;font-family:'SF Mono',SFMono-Regular,Menlo,Consolas,'Courier New',monospace;font-size:38px;line-height:46px;font-weight:700;letter-spacing:0.3em;color:#101828;">{{value}}</p>
    </td>
  </tr>
</table>

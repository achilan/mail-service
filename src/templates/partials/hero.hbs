{{!-- Encabezado de la tarjeta: ícono Material en badge, etiqueta, título y bajada.
      Uso: {{> hero icon="shield_lock" tone="success" eyebrow="Seguridad" title="..." subtitle="..."}}
      o con bloque para títulos dinámicos: {{#> hero icon="waving_hand"}}Hola {{name}}{{/hero}} --}}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px;border-collapse:separate;">
  <tr>
    <td width="52" height="52" align="center" valign="middle" bgcolor="{{toneColor tone 'bg'}}" style="width:52px;height:52px;border-radius:16px;background-color:{{toneColor tone 'bg'}};border:1px solid {{toneColor tone 'border'}};box-shadow:0 0 0 4px {{tintColor (toneColor tone 'bg') 0.4}};text-align:center;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td>{{icon (fallback icon 'mail') (toneColor tone 'fg') 26}}</td></tr></table>
    </td>
  </tr>
</table>
{{#if eyebrow}}
<p style="margin:0 0 8px;font-size:12px;line-height:18px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:{{toneColor tone 'fg'}};">{{eyebrow}}</p>
{{/if}}
<h1 class="em-heading em-h1" style="margin:0 0 12px;font-size:28px;line-height:36px;font-weight:800;letter-spacing:-0.02em;color:#101828;">{{#if @partial-block}}{{> @partial-block}}{{else}}{{title}}{{/if}}</h1>
{{#if subtitle}}
<p class="em-text" style="margin:0 0 28px;font-size:17px;line-height:27px;color:#475467;">{{subtitle}}</p>
{{else}}
<div style="height:12px;line-height:12px;font-size:12px;">&nbsp;</div>
{{/if}}

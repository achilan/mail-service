{{!-- Aviso destacado con tono semántico (success | info | warning | danger | neutral).
      Uso: {{> callout tone="warning" icon="schedule" title="..." text="..."}} o en bloque. --}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 28px;border-collapse:separate;">
  <tr>
    <td bgcolor="{{toneColor tone 'bg'}}" style="padding:16px 20px;background-color:{{toneColor tone 'bg'}};border:1px solid {{toneColor tone 'border'}};border-radius:14px;">
      {{#if title}}<p style="margin:0 0 4px;font-size:14px;line-height:22px;font-weight:700;color:{{toneColor tone 'fg'}};">{{#if icon}}{{icon icon (toneColor tone 'fg') 18 inline=true}}{{/if}}{{title}}</p>{{/if}}
      <p style="margin:0;font-size:14px;line-height:22px;color:{{toneColor tone 'fg'}};">{{#if @partial-block}}{{> @partial-block}}{{else}}{{text}}{{/if}}</p>
    </td>
  </tr>
</table>

{{> hero icon=(fallback icon 'mail') tone=tone eyebrow=eyebrow title=title subtitle=subtitle}}

{{#if message}}
<div class="em-content" style="margin:0 0 12px;">{{{safe message}}}</div>
{{/if}}

{{#if details}}
  {{> details items=details heading=(fallback detailsTitle 'Detalles')}}
{{/if}}

{{#if ctaUrl}}
  {{> button url=ctaUrl text=(fallback ctaText 'Ver más')}}
{{/if}}

{{#if note}}
  {{> callout tone='neutral' icon='lightbulb' text=note}}
{{/if}}

{{> signature}}

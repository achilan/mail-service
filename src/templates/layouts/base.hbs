<!doctype html>
<html lang="{{fallback brand.lang 'es'}}" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{subject}}</title>
  <!--[if mso]>
  <noscript><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
  <style>table,td,p,a,h1,h2,h3,span{font-family:'Segoe UI',Arial,sans-serif !important;}</style>
  <![endif]-->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { color-scheme: light dark; supported-color-schemes: light dark; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; -webkit-font-smoothing: antialiased; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; border-collapse: collapse; }
    img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; }
    a[x-apple-data-detectors], #MessageViewBody a { color: inherit !important; text-decoration: none !important; }
    .em-content p { margin: 0 0 16px; }
    .em-content ul, .em-content ol { margin: 0 0 16px; padding-left: 22px; }
    .em-content li { margin: 0 0 6px; }
    .em-content a { color: {{brand.primaryColor}}; font-weight: 600; text-decoration: underline; }
    .em-content strong, .em-content b { color: #101828; font-weight: 600; }
    .em-content h2, .em-content h3 { color: #101828; margin: 24px 0 8px; line-height: 1.3; }
    .em-content blockquote { margin: 0 0 16px; padding: 4px 0 4px 16px; border-left: 3px solid {{brand.primaryColor}}; color: #475467; }
    .em-btn a:hover { opacity: .92; }
    @media only screen and (max-width: 620px) {
      .em-outer { padding: 24px 8px !important; }
      .em-px { padding-left: 24px !important; padding-right: 24px !important; }
      .em-py { padding-top: 32px !important; padding-bottom: 36px !important; }
      .em-h1 { font-size: 24px !important; line-height: 32px !important; }
      .em-stack { display: block !important; width: 100% !important; box-sizing: border-box; }
      .em-stack-pad { padding: 0 0 16px !important; }
      .em-hide-sm { display: none !important; }
      .em-btn, .em-btn a { display: block !important; width: 100% !important; box-sizing: border-box; text-align: center !important; }
      .em-amount { font-size: 30px !important; line-height: 38px !important; }
    }
    @media (prefers-color-scheme: dark) {
      .em-bg { background-color: #0C0E12 !important; }
      .em-card { background-color: #161B26 !important; border-color: #1F242F !important; }
      .em-heading, .em-content strong, .em-content b, .em-content h2, .em-content h3 { color: #F5F5F6 !important; }
      .em-text, .em-content { color: #CECFD2 !important; }
      .em-muted { color: #94969C !important; }
      .em-panel { background-color: #0C111D !important; border-color: #1F242F !important; }
      .em-divider { border-color: #1F242F !important; }
      .em-wordmark { color: #F5F5F6 !important; }
    }
    [data-ogsc] .em-bg { background-color: #0C0E12 !important; }
    [data-ogsc] .em-card { background-color: #161B26 !important; border-color: #1F242F !important; }
    [data-ogsc] .em-heading { color: #F5F5F6 !important; }
    [data-ogsc] .em-text, [data-ogsc] .em-content { color: #CECFD2 !important; }
    [data-ogsc] .em-muted { color: #94969C !important; }
    [data-ogsc] .em-panel { background-color: #0C111D !important; border-color: #1F242F !important; }
  </style>
</head>
<body class="em-bg" style="margin:0;padding:0;background-color:#F2F4F7;">
  {{#if preheader}}
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">{{preheader}}&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>
  {{/if}}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="em-bg" bgcolor="#F2F4F7" style="background-color:#F2F4F7;">
    <tr>
      <td align="center" class="em-outer" style="padding:40px 16px;">
        <!--[if mso]><table role="presentation" width="600" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;margin:0 auto;">

          <!-- Marca -->
          <tr>
            <td style="padding:0 4px 24px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" valign="middle">
                    {{#if brand.logoUrl}}
                      <img src="{{safeUrl brand.logoUrl}}" alt="{{brand.name}}" height="36" style="display:block;height:36px;width:auto;max-width:200px;">
                    {{else}}
                      <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                        <tr>
                          <td width="38" height="38" align="center" valign="middle" bgcolor="{{brand.primaryColor}}" style="width:38px;height:38px;border-radius:11px;background-color:{{brand.primaryColor}};background-image:linear-gradient(135deg,{{brand.primaryColor}} 0%,{{brand.accentColor}} 100%);color:#FFFFFF;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:800;line-height:38px;text-align:center;">{{initialOf brand.name}}</td>
                          <td class="em-wordmark" style="padding-left:12px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;font-weight:700;letter-spacing:-0.01em;color:#101828;">{{brand.name}}</td>
                        </tr>
                      </table>
                    {{/if}}
                  </td>
                  {{#if brand.website}}
                  <td align="right" valign="middle" class="em-hide-sm" style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;">
                    <a href="{{safeUrl brand.website}}" target="_blank" class="em-muted" style="color:#667085;text-decoration:none;font-weight:500;">Visitar sitio&nbsp;&rarr;</a>
                  </td>
                  {{/if}}
                </tr>
              </table>
            </td>
          </tr>

          <!-- Tarjeta principal -->
          <tr>
            <td class="em-card" bgcolor="#FFFFFF" style="background-color:#FFFFFF;border:1px solid #EAECF0;border-radius:24px;box-shadow:0 1px 2px rgba(16,24,40,0.05),0 16px 40px -12px rgba(16,24,40,0.12);">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td height="6" bgcolor="{{brand.primaryColor}}" style="height:6px;line-height:6px;font-size:6px;border-radius:24px 24px 0 0;background-color:{{brand.primaryColor}};background-image:linear-gradient(90deg,{{brand.primaryColor}} 0%,{{brand.accentColor}} 100%);">&nbsp;</td>
                </tr>
                <tr>
                  <td class="em-px em-py em-text" style="padding:44px 48px 48px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:26px;color:#475467;">
                    {{{body}}}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Pie -->
          <tr>
            <td align="center" style="padding:32px 24px 8px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;color:#667085;" class="em-muted">
              {{#if brand.socialLinks.length}}
              <p style="margin:0 0 16px;">
                {{#each brand.socialLinks}}
                  <a href="{{safeUrl url}}" target="_blank" style="display:inline-block;margin:0 4px 6px;padding:6px 12px;border:1px solid #D0D5DD;border-radius:999px;color:#344054;font-weight:600;font-size:12px;text-decoration:none;" class="em-muted">{{label}}</a>
                {{/each}}
              </p>
              {{/if}}
              {{#if brand.supportEmail}}
              <p style="margin:0 0 8px;">¿Necesitas ayuda? Escríbenos a <a href="mailto:{{brand.supportEmail}}" style="color:{{brand.primaryColor}};font-weight:600;text-decoration:none;">{{brand.supportEmail}}</a></p>
              {{/if}}
              {{#if brand.address}}<p style="margin:0 0 8px;">{{brand.address}}</p>{{/if}}
              {{#if brand.footerNote}}<p style="margin:0 0 8px;">{{brand.footerNote}}</p>{{/if}}
              {{#if unsubscribeUrl}}
              <p style="margin:0 0 8px;"><a href="{{safeUrl unsubscribeUrl}}" style="color:#667085;text-decoration:underline;" class="em-muted">Dejar de recibir estos correos</a></p>
              {{/if}}
              <p style="margin:12px 0 0;font-size:12px;color:#98A2B3;">&copy; {{currentYear}} {{brand.name}}. Todos los derechos reservados.</p>
            </td>
          </tr>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
